<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- NewGamePlus.Tests is a subdirectory of this project's directory, so it's
         otherwise picked up by this project's own default **/*.cs glob too. -->
    <Compile Remove="NewGamePlus.Tests/**" />
  </ItemGroup>

</Project>
